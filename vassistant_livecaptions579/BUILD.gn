import("//build/ohos.gni")

# Real source app compiled by the normal platform app/sign/package graph.
ohos_app("vassistant_livecaptions579") {
  deps = []
  certificate_profile = "signature/vassistant.p7b"
  hap_name = "VAssistant"
  part_name = "prebuilt_hap"
  subsystem_name = "applications"
  module_install_dir = "app/com.ohos.vassistant"
  sdk_home = "//prebuilts/ohos-sdk/linux"
  sdk_type_name = [ "sdk.dir" ]
  assemble_type = "assembleHap"
  build_level = "module"
  js_build_mode = "release"
  build_modules = [ "entry" ]
}
